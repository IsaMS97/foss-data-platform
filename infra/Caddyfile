# Dockhand service
dockhand.platform.smith-data.de {
    reverse_proxy dockhand:3000
    tls /etc/caddy/certificates/wildcard.crt /etc/caddy/certificates/wildcard.key
}

s3.platform.smith-data.de {
    reverse_proxy localhost:9000
    tls /etc/caddy/certificates/wildcard.crt /etc/caddy/certificates/wildcard.key
}

storage.platform.smith-data.de {
    reverse_proxy localhost:9001
    tls /etc/caddy/certificates/wildcard.crt /etc/caddy/certificates/wildcard.key
}
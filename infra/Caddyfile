# Dockhand service
{$DOCKHAND_PUBLIC_HOST:dockhand.localhost} {
    reverse_proxy dockhand:3000
    tls /etc/caddy/certificates/wildcard.crt /etc/caddy/certificates/wildcard.key
}

{$S3_PUBLIC_HOST:s3.localhost} {
    reverse_proxy rustfs:9000
    tls /etc/caddy/certificates/wildcard.crt /etc/caddy/certificates/wildcard.key
}

{$STORAGE_PUBLIC_HOST:storage.localhost} {
    reverse_proxy rustfs:9001
    tls /etc/caddy/certificates/wildcard.crt /etc/caddy/certificates/wildcard.key
}

{$CATALOG_PUBLIC_HOST:catalog.localhost} {
    reverse_proxy lakekeeper:8181
    tls /etc/caddy/certificates/wildcard.crt /etc/caddy/certificates/wildcard.key
}

{$KEYCLOAK_PUBLIC_HOST:keycloak.localhost} {
    reverse_proxy keycloak:8080
    tls /etc/caddy/certificates/wildcard.crt /etc/caddy/certificates/wildcard.key
}